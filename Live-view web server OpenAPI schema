openapi: 3.0.3
info:
  title: AI-Ready Documentation Crawler - Live View API
  description: "API for retrieving live crawling progress, logs, datasets, and outputs from the AI-Ready Documentation Crawler."
  version: 1.0.0
servers:
  - url: https://crawler.example.com
    description: Production server
  - url: https://staging.crawler.example.com
    description: Staging server

paths:
  /status:
    get:
      summary: Get Actor Status
      description: Get the current status of the Actor, including progress, uptime, and operational state.
      responses:
        "200":
          description: Actor status retrieved successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                    description: Current operational state (`running`, `stopped`, `failed`, `completed`).
                    example: "running"
                  uptime:
                    type: integer
                    description: Time (in seconds) since the Actor started.
                    example: 3600
                  completedRequests:
                    type: integer
                    description: Number of pages successfully crawled.
                    example: 95
                  failedRequests:
                    type: integer
                    description: Number of pages that failed to crawl.
                    example: 5
                  maxRequests:
                    type: integer
                    description: Maximum number of pages to crawl as specified in the input.
                    example: 100
        "500":
          description: Failed to retrieve Actor status

  /logs:
    get:
      summary: Retrieve Actor Logs
      description: Retrieve real-time logs generated by the Actor during the crawl process.
      parameters:
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            default: 50
          description: The number of recent log entries to return.
      responses:
        "200":
          description: Logs retrieved successfully
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    timestamp:
                      type: string
                      format: date-time
                      description: When the log entry was generated.
                      example: "2026-05-17T15:21:00Z"
                    level:
                      type: string
                      description: Log level (`info`, `warning`, `error`, etc.).
                      example: "info"
                    message:
                      type: string
                      description: The log message.
                      example: "Crawling: https://example.com/documentation"
        "500":
          description: Failed to retrieve logs

  /datasets:
    get:
      summary: List Available Datasets
      description: List all datasets generated by the Actor during or after the crawl.
      responses:
        "200":
          description: Datasets retrieved successfully
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    id:
                      type: string
                      description: Unique identifier for the dataset.
                      example: "default"
                    createdAt:
                      type: string
                      format: date-time
                      description: When the dataset was created.
                      example: "2026-05-17T14:30:00Z"
                    itemCount:
                      type: integer
                      description: Number of items in the dataset.
                      example: 100
        "500":
          description: Failed to retrieve datasets

  /dataset/{id}/items:
    get:
      summary: Retrieve Dataset Items
      description: Fetch items from the specified dataset.
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
          description: The unique ID of the dataset to fetch items from.
          example: "default"
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            default: 10
          description: Number of items to return.
        - name: offset
          in: query
          required: false
          schema:
            type: integer
            default: 0
          description: Pagination offset for the dataset items.
      responses:
        "200":
          description: Dataset items retrieved successfully
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    title:
                      type: string
                      description: Title of the documentation page.
                      example: "Getting Started with Crawlee"
                    url:
                      type: string
                      description: The URL where the page was crawled from.
                      example: "https://example.com/docs/getting-started"
                    markdown:
                      type: string
                      description: The Markdown content of the page.
                      example: "# Getting Started\n..."
        "404":
          description: Dataset not found
        "500":
          description: Failed to retrieve dataset items

  /export:
    get:
      summary: Export Documentation
      description: Generate and download a full export of all crawled documentation.
      responses:
        "200":
          description: Export file generated successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  exportUrl:
                    type: string
                    description: URL of the generated export file.
                    example: "https://crawler.example.com/exports/documentation.jsonl"
        "500":
          description: Failed to generate export
